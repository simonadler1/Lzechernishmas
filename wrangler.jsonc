{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lzecher-nishmas",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // One Worker serves the API and the React app. Unknown paths fall back to
  // index.html so deep links such as /c/<slug> load the SPA.
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  // Hourly, because reminders go out at about 10:00 in each campaign's timezone.
  "triggers": { "crons": ["0 * * * *"] },
  "secrets": { "required": ["TOKEN_SECRET"] },
  "vars": { "ENVIRONMENT": "development", "MESSAGING_MODE": "mock", "APP_URL": "http://localhost:5173" },
  "d1_databases": [
    { "binding": "DB", "database_name": "lzecher-nishmas-local", "database_id": "local", "migrations_dir": "migrations" }
  ]
}
