{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Every account-specific value in the project lives in this file: account_id,
  // the two database_id values, preview's APP_URL, and production's domain and
  // APP_URL. `pnpm cf:setup` fills in the first three. Local development and
  // `pnpm deploy:check` work while the REPLACE placeholders are still here.
  // See docs/DEPLOYING.md.
  "name": "lzecher-nishmas",
  "account_id": "REPLACE_ACCOUNT_ID",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // One Worker serves the API and the React app. Unknown paths fall back to
  // index.html so deep links such as /c/<slug> load the SPA.
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  // Hourly, because reminders go out at about 10:00 in each campaign's timezone.
  "triggers": { "crons": ["0 * * * *"] },
  "secrets": { "required": ["TOKEN_SECRET"] },
  // No public address except the ones configured below.
  "workers_dev": false,
  "preview_urls": false,

  // Local development. Bindings, vars and secrets are not inherited, so each
  // environment below repeats them.
  "vars": { "ENVIRONMENT": "development", "MESSAGING_MODE": "mock", "APP_URL": "http://localhost:5173" },
  "d1_databases": [
    { "binding": "DB", "database_name": "lzecher-nishmas-local", "database_id": "local", "migrations_dir": "migrations" }
  ],

  "env": {
    // Shared team testing, behind Cloudflare Access.
    "preview": {
      "workers_dev": true,
      "secrets": { "required": ["TOKEN_SECRET"] },
      "vars": { "ENVIRONMENT": "preview", "MESSAGING_MODE": "mock", "APP_URL": "REPLACE_PREVIEW_URL" },
      "d1_databases": [
        { "binding": "DB", "database_name": "lzecher-nishmas-preview", "database_id": "REPLACE", "migrations_dir": "migrations" }
      ]
    },
    // Real campaigns. MESSAGING_MODE must be a real provider before the first deploy.
    "production": {
      "routes": [{ "pattern": "REPLACE_PRODUCTION_DOMAIN", "custom_domain": true }],
      "secrets": { "required": ["TOKEN_SECRET"] },
      "vars": { "ENVIRONMENT": "production", "MESSAGING_MODE": "mock", "APP_URL": "https://REPLACE_PRODUCTION_DOMAIN" },
      "d1_databases": [
        { "binding": "DB", "database_name": "lzecher-nishmas-production", "database_id": "REPLACE", "migrations_dir": "migrations" }
      ]
    }
  }
}
